# server configuration
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://127.0.0.1:8080

# database (Postgres dev: make db-up / docker-compose.db.yaml)
DB_HOST=localhost
DB_USER=grafika
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=grafika
DB_PORT=5433

# Opsional: override URL penuh (abaikan DB_* jika diisi)
# DATABASE_URL=postgres://grafika:CHANGE_ME@localhost:5433/grafika?sslmode=disable

# ML (docker: http://web-ml:<port> setelah ML service ada)
ML_SERVICE_URL=http://localhost:8000

# Opsional: path migrasi relatif ke root modul (default: database/migrations)
# MIGRATIONS_PATH=database/migrations

# GORM AutoMigrate saat server start (default off jika pakai init.sql)
# GIS_AUTO_MIGRATE=true

TZ=Asia/Jakarta
