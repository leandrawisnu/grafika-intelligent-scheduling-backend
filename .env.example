# server configuration
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://127.0.0.1:8080

# database — Postgres lokal (default port 5432, tanpa Docker)
DB_HOST=localhost
DB_USER=grafika
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=grafika
DB_PORT=5432

# Opsional: override URL penuh (abaikan DB_* jika diisi)
# DATABASE_URL=postgres://grafika:CHANGE_ME@localhost:5432/grafika?sslmode=disable

# Opsional: Postgres via Docker → make db-up (biasanya DB_PORT=5433 di .env)
# DB_PORT=5433

# ML
ML_SERVICE_URL=http://localhost:8000

# MIGRATIONS_PATH=database/migrations
# GIS_AUTO_MIGRATE=true

TZ=Asia/Jakarta
