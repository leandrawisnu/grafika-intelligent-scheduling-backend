# --- API direct (skrip smoke, bootstrap, …) ---
# Backend langsung: http://127.0.0.1:6060 atau http://<IP-VM>:8080
# K6_BASE_URL=http://127.0.0.1:6060
#
# --- FE end-to-end (skrip fe-smoke, fe-bootstrap, …) ---
# Origin frontend — request lewat Next.js proxy /api/v1 (sama seperti browser)
# Local:  http://127.0.0.1:3000
# Prod:   https://your-domain  (harus lewat frontend, bukan port backend)
K6_BASE_URL=http://127.0.0.1:3000

# Load test account (not the production admin; seed with
# ../scripts/seed-loadtest-user.sh)
K6_USER=loadtest@grafika.sch.id
K6_PASSWORD=GrafikaLoadTest2026!

# Opsional: override ID jadwal (kosong = auto dari GET /jadwal-semester)
K6_JADWAL_SEMESTER_ID=
K6_JADWAL_KELAS_ID=

# Catatan: backend membatasi endpoint berat per pengguna lewat
# GIS_RATE_LIMIT (default 60/menit; 0 = mati). Untuk load test,
# naikkan atau matikan di .env backend, bukan di file ini.
